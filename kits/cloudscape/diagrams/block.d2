classes: {
  block: {...${cloudscape.node}; width: 180; style: {fill: ${color.surface}; stroke: ${color.card-border}; border-radius: 8}}
  group: {...${cloudscape.container}; style: {fill: ${color.surface-subtle}; stroke: ${color.divider}; border-radius: 16}}
  link: {...${cloudscape.line}; style.stroke: ${color.line}}
}
