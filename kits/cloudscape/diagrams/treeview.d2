classes: {
  root: {height: 32; style: {border-radius: 16; fill: ${color.strong}; stroke: ${color.strong}; stroke-width: 1; font-size: 14; font-color: ${color.on-strong}; bold: true}}
  branch: {height: 32; style: {border-radius: 16; fill: ${color.surface}; stroke: ${color.card-border}; stroke-width: 1; font-size: 14; font-color: ${color.text}; bold: true}}
  leaf: {shape: text; style: {font-size: 14; font-color: ${color.text}; bold: false}}
  link: {style: {stroke: ${color.divider}; stroke-width: 1}}
}
