# sql_table: fill is the header, stroke is the row background.
classes: {
  entity: {style: {fill: ${color.surface-subtle}; stroke: ${color.surface}; font-color: ${color.heading}; font-size: 14}}
  relation: {...${cloudscape.line}; style.stroke: ${color.line}}
  one-to-one: {...${cloudscape.line}; style.stroke: ${color.line}}
  one-to-many: {...${cloudscape.line}; style.stroke: ${color.line}}
  many-to-one: {...${cloudscape.line}; style.stroke: ${color.line}}
  many-to-many: {...${cloudscape.line}; style.stroke: ${color.line}}
}
