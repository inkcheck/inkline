classes: {
  participant: {...${cloudscape.node}; style: {fill: ${color.surface}; stroke: ${color.card-border}; border-radius: 8}}
  # D2 sizes sequence actors itself, so an actor is a participant card with a
  # Cloudscape avatar (avatar decorator). Same outline as participants: D2
  # draws each lifeline in its participant's outline colour.
  actor: {...${cloudscape.node}; shape: rectangle; width: 160; style: {fill: ${color.surface}; stroke: ${color.card-border}; border-radius: 8}}
  message: {...${cloudscape.line}; style.stroke: ${color.line}}
  reply: {...${cloudscape.line}; style: {stroke: ${color.line}; stroke-dash: 3}}
  async: {...${cloudscape.line}; style.stroke: ${color.line}; target-arrowhead.shape: arrow}
}
