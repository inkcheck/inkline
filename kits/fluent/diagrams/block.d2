classes: {
  block: {...${fluent.node}; width: 180; style: {fill: ${color.surface}; stroke: ${color.card-border}; border-radius: 4}}
  group: {...${fluent.container}; style: {fill: ${color.surface-subtle}; stroke: ${color.divider}; border-radius: 8}}
  link: {...${fluent.line}; style.stroke: ${color.line}}
}
