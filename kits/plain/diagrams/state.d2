classes: {
  state: {style.border-radius: 8}
  start: {shape: circle; width: 16; height: 16; label: ""; style.fill: ${plain.ink}; style.stroke: ${plain.ink}}
  end: {shape: circle; width: 20; height: 20; label: ""; style.double-border: true; style.fill: ${plain.ink}; style.stroke: ${plain.ink}}
  choice: {shape: diamond; width: 28; height: 28; label: ""}
  fork: {width: 96; height: 8; label: ""; style.fill: ${plain.ink}; style.stroke: ${plain.ink}}
  join: {width: 96; height: 8; label: ""; style.fill: ${plain.ink}; style.stroke: ${plain.ink}}
  note: {shape: page}
  composite: {style.border-radius: 8}
  transition: {}
}
