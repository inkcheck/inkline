# Carbon light theme (Technical diagrams kit p5, p9). Primary colours are 50–80 swatches; fills are
# Color 10 or White.
vars: {
  color: {
    canvas: "#ffffff"
    text: "#161616"
    text-muted: "#525252"
    on-strong: "#ffffff"
    surface: "#ffffff"
    surface-subtle: "#f2f4f8"
    outline: "#4d5358"
    line: "#161616"
    line-muted: "#c6c6c6"
    strong: "#4d5358"
    actor: "#000000"
    red: "#fa4d56"
    magenta: "#ee5396"
    purple: "#a56eff"
    blue: "#0f62fe"
    cyan: "#1192e8"
    teal: "#009d9a"
    teal-dark: "#005d5d"
    green: "#198038"
    green-subtle: "#defbe6"
    gray: "#878d96"
  }
  d2-config: {
    theme-overrides: {
      N1: "#161616"
      N2: "#525252"
      N3: "#6f6f6f"
      N4: "#8d8d8d"
      N5: "#c6c6c6"
      N6: "#e0e0e0"
      N7: "#ffffff"
      B1: "#161616"
      B2: "#4d5358"
      B3: "#878d96"
      B4: "#dde1e6"
      B5: "#f2f4f8"
      B6: "#ffffff"
      AA2: "#0f62fe"
      AA4: "#edf5ff"
      AA5: "#f2f4f8"
      AB4: "#edf5ff"
      AB5: "#f2f4f8"
    }
  }
}
