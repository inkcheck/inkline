# sql_table: fill is the header, stroke is the row background.
classes: {
  entity: {style: {fill: ${color.strong}; stroke: ${color.surface}; font-color: ${color.on-strong}; font-size: 14}}
  relation: {...${carbon.line}; style.stroke: ${color.line}}
  one-to-one: {...${carbon.line}; style.stroke: ${color.line}}
  one-to-many: {...${carbon.line}; style.stroke: ${color.line}}
  many-to-one: {...${carbon.line}; style.stroke: ${color.line}}
  many-to-many: {...${carbon.line}; style.stroke: ${color.line}}
}
