classes: {
  frame: {label.near: outside-top-center; style: {fill: transparent; stroke: transparent; font-size: 16; font-color: ${color.text}; bold: true}}
  quadrant: {
    width: 320
    height: 240
    label.near: top-left
    style: {fill: ${color.surface-subtle}; stroke: ${color.canvas}; stroke-width: 2; font-size: 14; font-color: ${color.text}; bold: true}
  }
  item: {
    shape: circle
    width: 12
    height: 12
    label.near: outside-right-center
    style: {fill: ${color.blue}; stroke: ${color.blue}; font-size: 14; font-color: ${color.text}; bold: false}
  }
  axis: {shape: text; style: {font-size: 12; font-color: ${color.text-muted}}}
}
