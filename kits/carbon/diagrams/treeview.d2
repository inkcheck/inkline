# Kit p11: pill-outlined parents, plain-text leaves, light Bézier links.
classes: {
  root: {height: 32; style: {border-radius: 16; fill: ${color.canvas}; stroke: ${color.text}; stroke-width: 1; font-size: 14; font-color: ${color.text}; bold: true}}
  branch: {height: 32; style: {border-radius: 16; fill: ${color.canvas}; stroke: ${color.text}; stroke-width: 1; font-size: 14; font-color: ${color.text}; bold: true}}
  leaf: {shape: text; style: {font-size: 14; font-color: ${color.text}; bold: false}}
  link: {style: {stroke: ${color.line-muted}; stroke-width: 1}}
}
